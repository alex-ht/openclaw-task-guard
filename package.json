{
  "name": "@alex-ht/openclaw-task-guard",
  "version": "1.1.0",
  "description": "Stop OpenClaw agents from ending a turn before planned deliverables (content and format) are done.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "tasks",
    "deliverables"
  ],
  "author": "AlexHT Hung",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-ht/openclaw-task-guard.git"
  },
  "bugs": {
    "url": "https://github.com/alex-ht/openclaw-task-guard/issues"
  },
  "homepage": "https://github.com/alex-ht/openclaw-task-guard#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "typebox": "1.3.30"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24-beta.2"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2",
      "pluginSdkVersion": "2026.3.24-beta.2"
    }
  }
}
